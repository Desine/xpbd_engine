suspension_target_angle:5.0
suspension_kp:10000.0
suspension_kd:1000.0
suspension_max_torque:10000.0
wheel_hub_l_pos:[-0.3, -0.03]
wheel_hub_r_pos:[ 1.5, -0.03]
$wheel
{
  "name": "car_body",
  "offset": [0, 0],
  "Particles": [
    { "pos": [-0.4, 0.0], "mass": 150, "name": "bottom_l" },
    { "pos": [1.7, 0.0], "mass": 150, "name": "bottom_r"  },
    { "pos": [2.1, 0.2], "mass": 150 },
    { "pos": [2.1, 0.6], "mass": 150 },

    { "pos": [1.1, 0.8], "mass": 150 },
    { "pos": [0.7, 1.3], "mass": 150 },
    { "pos": [-0.2, 1.3], "mass": 150 },
    { "pos": [-0.9, 0.7], "mass": 150 },
    { "pos": [-0.8, 0.2], "mass": 150 },

    { "pos": $wheel_hub_l_pos, "mass": 10, "name": "wheel_hub_l" },
    { "pos": $wheel_hub_r_pos, "mass": 10, "name": "wheel_hub_r" }
  ],
  "DistanceConstraints": [
    { "p1": 0, "p2": 1, "compliance": 0.0 },
    { "p1": 1, "p2": 2, "compliance": 0.0 },
    { "p1": 2, "p2": 3, "compliance": 0.0 },
    { "p1": 3, "p2": 4, "compliance": 0.0 },
    { "p1": 4, "p2": 5, "compliance": 0.0 },
    { "p1": 5, "p2": 6, "compliance": 0.0 },
    { "p1": 6, "p2": 7, "compliance": 0.0 },
    { "p1": 7, "p2": 8, "compliance": 0.0 },
    { "p1": 8, "p2": 0, "compliance": 0.0 },
    
    { "p1": "bottom_r", "p2": "wheel_hub_l", "compliance": 0.0 },
    { "p1": "bottom_l", "p2": "wheel_hub_r", "compliance": 0.0 }
  ],
  "AngleConstraints": [
    { "p1": 8,  "p2": 0, "p3": 0, "p4": 1, "compliance": 0.000003 },
    { "p1": 0,  "p2": 1, "p3": 1, "p4": 2, "compliance": 0.000003 },
    { "p1": 1,  "p2": 2, "p3": 2, "p4": 3, "compliance": 0.000003 },
    { "p1": 2,  "p2": 3, "p3": 3, "p4": 4, "compliance": 0.000003 },
    { "p1": 3,  "p2": 4, "p3": 4, "p4": 5, "compliance": 0.000003 },
    { "p1": 4,  "p2": 5, "p3": 5, "p4": 6, "compliance": 0.000003 },
    { "p1": 5,  "p2": 6, "p3": 6, "p4": 7, "compliance": 0.000003 },
    { "p1": 6,  "p2": 7, "p3": 7, "p4": 8, "compliance": 0.000003 },
    { "p1": 7,  "p2": 8, "p3": 8, "p4": 0, "compliance": 0.000003 },

    { "p1": "bottom_r",  "p2": "bottom_l", "p3": "bottom_r", "p4": "wheel_hub_l", "compliance": 0.0, "min_angle": -8, "max_angle": 5},
    { "p1": "bottom_l",  "p2": "bottom_r", "p3": "bottom_l", "p4": "wheel_hub_r", "compliance": 0.0, "min_angle": -5, "max_angle": 8 }
  ],
  "PolygonColliders": [
    {
      "indices": [0, 1, 2, 3, 4, 5, 6, 7, 8],
      "static_friction": 0.1,
      "kinetic_friction": 0.3,
      "compliance": 0.000001,
      "layer": 2,
      "mask": 1
    }
  ],
  "PointsColliders": [
    {
      "indices": [ "wheel_hub_l", "wheel_hub_r" ],
      "static_friction": 0.1,
      "kinetic_friction": 0.3,
      "compliance": 0.000001,
      "layer": 2,
      "mask": 1
    }
  ],
  "AngularServos": [
    {
        "p1": "bottom_r",
        "p2": "bottom_l",
        "p3": "bottom_r",
        "p4": "wheel_hub_l",

        "target_angle": $suspension_target_angle,
        "kp": $suspension_kp,
        "kd": $suspension_kd,
        "max_torque": $suspension_max_torque
    },
    {
        "p1": "bottom_l",
        "p2": "bottom_r",
        "p3": "bottom_l",
        "p4": "wheel_hub_r",

        "target_angle": -$suspension_target_angle,
        "kp": $suspension_kp,
        "kd": $suspension_kd,
        "max_torque": $suspension_max_torque
    }
  ]
}
